#
# Package config for find_package(jspassgen CONFIG): defines the
# imported target jspassgen::jspassgen. The library has no third-party
# dependency; on Windows it links the system's bcrypt.lib.
@PACKAGE_INIT@

include("${CMAKE_CURRENT_LIST_DIR}/jspassgenTargets.cmake")
check_required_components(jspassgen)
