#!/bin/sh
# SPDX-License-Identifier: Apache-2.0 OR MIT
#
# Fails when a version-bearing file disagrees with the project version in
# CMakeLists.txt (the single source of truth). Run by `make check` and CI.
# Usage: scripts/verify-release-versions [expected-version]
set -eu
cd "$(dirname "$0")/.."

version=$(sed -n 's/^project(jspassgen VERSION \([0-9.]*\) .*/\1/p' CMakeLists.txt)
if [ -z "$version" ]; then
  echo "verify-release-versions: no version in CMakeLists.txt" >&2
  exit 1
fi
if [ $# -gt 0 ] && [ "$1" != "$version" ]; then
  echo "verify-release-versions: CMakeLists.txt says $version, expected $1" >&2
  exit 1
fi

status=0
# expect FILE FIXED-STRING: FILE must contain FIXED-STRING.
expect() {
  if ! grep -qF -- "$2" "$1"; then
    echo "$1: missing '$2'" >&2
    status=1
  fi
}

expect CITATION.cff "version: \"$version\""
expect SECURITY.md "| \`$version\`"
expect SUPPORT.md "| \`$version\`"
expect docs/index.md "GIT_TAG        v$version)"
expect README.md "GIT_TAG        v$version)"
expect README.md "find_package(jspassgen $version CONFIG REQUIRED)"
expect .github/ISSUE_TEMPLATE/bug_report.yml "placeholder: \"$version\""
expect tests/package/CMakeLists.txt "find_package(jspassgen $version CONFIG REQUIRED)"
# The release prep dates the heading; until then it says Unreleased.
if ! grep -qE "^## \[$version\] - (Unreleased|[0-9]{4}-[0-9]{2}-[0-9]{2})$" CHANGELOG.md; then
  echo "CHANGELOG.md: no '## [$version] - Unreleased' (or dated) heading" >&2
  status=1
fi

if [ "$status" -eq 0 ]; then
  echo "verify-release-versions: every file says $version"
fi
exit "$status"
